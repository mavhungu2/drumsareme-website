rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public catalog read so the static site can show live price + in-stock
    // status without going through a Cloud Function. Writes still flow through
    // adminProducts (which uses requireAdmin) — denying client writes here.
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // Default: deny everything. All other collections (orders, inventory,
    // expenses, admins) are read/written exclusively via Cloud Functions
    // running with the Admin SDK, which bypasses these rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
